# --- Signature : générée par ../ios-updater depuis ios-updater.conf ---
Config/Signing.local.xcconfig

# --- Projet Xcode : généré par XcodeGen depuis project.yml ---
*.xcodeproj/
*.xcworkspace/

# --- Produits de compilation ---
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive/

# --- Données utilisateur Xcode ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# --- Swift Package Manager (si des dépendances sont ajoutées un jour) ---
.swiftpm/
.build/

# --- Signature : ne jamais versionner certificats ni profils ---
*.mobileprovision
*.provisionprofile
*.p12
*.cer

# --- Journaux ---
*.log

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Éditeurs ---
.vscode/
.idea/
*.swp
*~

# --- Claude Code : réglages locaux ---
.claude/settings.local.json
